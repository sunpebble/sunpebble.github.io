---
import { STRINGS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  homeHref: string;
  otherHref: string;
  isHome?: boolean;
}

const { lang, homeHref, otherHref, isHome = false } = Astro.props;
const t = STRINGS[lang];
const sectionHref = (section: string) => `${isHome ? '' : homeHref}#${section}`;
const themeLabel = lang === 'zh' ? '切换深色或浅色主题' : 'Toggle dark or light theme';
const languageLabel = lang === 'zh' ? '切换到英文' : 'Switch to Chinese';
---

<header class="header">
  <a href={homeHref} class="header-brand" aria-label={lang === 'zh' ? 'Sunpebble 首页' : 'Sunpebble home'}>
    <img src="/logo.svg" width="36" height="36" alt="" />
    <span>Sunpebble</span>
  </a>
  <div class="header-tools">
    <nav class="nav" aria-label={lang === 'zh' ? '站点导航' : 'Studio navigation'}>
      <a href={sectionHref('apps')}>{t.navApps}</a>
      <a href={sectionHref('about')}>{t.navAbout}</a>
    </nav>
    <a class="lang-toggle" href={otherHref} aria-label={languageLabel} title={languageLabel}>{t.switchTo}</a>
    <button class="theme-toggle" type="button" aria-label={themeLabel} aria-pressed="false" title={themeLabel}>
      <svg class="ico ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13.2A8 8 0 1 1 10.8 4a6.2 6.2 0 0 0 9.2 9.2Z"/></svg>
      <svg class="ico ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><line x1="12" y1="2.4" x2="12" y2="4.6"/><line x1="12" y1="19.4" x2="12" y2="21.6"/><line x1="2.4" y1="12" x2="4.6" y2="12"/><line x1="19.4" y1="12" x2="21.6" y2="12"/><line x1="5.1" y1="5.1" x2="6.7" y2="6.7"/><line x1="17.3" y1="17.3" x2="18.9" y2="18.9"/><line x1="5.1" y1="18.9" x2="6.7" y2="17.3"/><line x1="17.3" y1="6.7" x2="18.9" y2="5.1"/></svg>
    </button>
  </div>
</header>
