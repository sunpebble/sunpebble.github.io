---
import Home from '../components/Home.tsx';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeScript from '../components/ThemeScript.astro';
import Favicon from '../components/Favicon.astro';
import { META, STRINGS, HTML_LANG, type Lang } from '../i18n';
import '../styles/site.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { title, description } = META[lang];

// Route-level i18n: English homepage at '/', Chinese at '/zh/'.
const enHref = '/';
const zhHref = '/zh/';
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);

---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f7f7f2" />
  <ThemeScript />
  <title>{title}</title>
  <Favicon />
  <link rel="alternate" hreflang="en" href={abs(enHref)} />
  <link rel="alternate" hreflang="zh-Hans" href={abs(zhHref)} />
  <link rel="alternate" hreflang="x-default" href={abs(enHref)} />

  <!-- OG / Twitter Card -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/og-image.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body id="top">
  <a href="#main-content" class="skip-link">{STRINGS[lang].skip}</a>
  <div class="page page-home">
    <SiteHeader lang={lang} homeHref={lang === 'zh' ? '/zh/' : '/'} otherHref={lang === 'zh' ? '/' : '/zh/'} isHome />
    <Home lang={lang} />
  </div>
</body>
</html>
